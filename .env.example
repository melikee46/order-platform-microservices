# Docker Compose Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

RABBITMQ_USER=your_rabbitmq_username
RABBITMQ_PASS=your_secure_rabbitmq_password
RabbitMQ__Username=your_rabbitmq_username
RabbitMQ__Password=your_secure_rabbitmq_password
ORDER_DB_PASSWORD=your_secure_order_db_password
PAYMENT_DB_PASSWORD=your_secure_payment_db_password
AUTH_ISSUER=https://order-platform.local
AUTH_AUDIENCE=order-platform
AUTH_SIGNING_KEY=replace_with_a_random_secret_at_least_32_characters_long
